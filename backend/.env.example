# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration
# For development, update with your actual PostgreSQL credentials.
# For testing, DATABASE_URL has a default value and can be omitted.
# The database name is arbitrary — it only has to match the database you created.
DATABASE_URL="postgresql://postgres:***@localhost:5432/oracle_selex?schema=public"

# G4 Scoring Service (Python, started automatically as a child process)
# cGcC and G4Hunter are computed by backend/g4_service.py. Both the Node backend
# and the Python service read G4_PORT, so it only needs changing in one place.
G4_PORT=3002
# Set G4_SERVICE_URL instead if G4 scoring runs on a different host.
# G4_SERVICE_URL=http://localhost:3002
#
# G4NN is OPTIONAL. It needs a pre-trained model that is deliberately NOT
# bundled with this repository, because it is published under GPL-3.0 with
# G4RNA screener (Garant et al., 2017). Without the model, g4NN is reported as
# null and the composite score is computed from cGcC and G4Hunter only —
# it is never silently replaced by a substitute value.
# Default lookup path: <repo>/models/G4RNA_2016-11-07.pkl
# See scripts/fetch_g4nn_model.md for how to obtain and install it.
# G4NN_MODEL_PATH=/absolute/path/to/G4RNA_2016-11-07.pkl

# CORS Configuration
# Set to "*" to allow all origins (default), or specify a URL like "http://localhost:5173"
# WARNING: Using "*" disables credentials (cookies, authorization headers)
CORS_ORIGIN=*

# Logging Configuration
# Log levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
